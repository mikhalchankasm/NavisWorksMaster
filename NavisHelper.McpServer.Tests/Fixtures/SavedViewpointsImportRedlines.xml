<?xml version="1.0" encoding="utf-8"?>
<exchange>
  <viewpoints>
    <viewfolder name="Imported Folder">
      <view name="Redline View">
        <viewpoint render="shaded" lighting="scenelights">
          <camera projection="perspective">
            <position>
              <pos3f x="0" y="0" z="10" />
            </position>
            <rotation>
              <quaternion a="0" b="0" c="0" d="-1" />
            </rotation>
          </camera>
          <up>
            <vec3f x="0" y="1" z="0" />
          </up>
        </viewpoint>
        <redlines>
          <rlline thickness="3">
            <colour red="1" green="0" blue="0" />
            <start><pos2f x="-1" y="-1" /></start>
            <end><pos2f x="1" y="1" /></end>
          </rlline>
          <rlellipse thickness="4">
            <colour red="0.25" green="0.5" blue="0.75" />
            <start><pos2f x="-2" y="-1" /></start>
            <end><pos2f x="2" y="1" /></end>
          </rlellipse>
          <rlarrow thickness="2">
            <colour red="1" green="0" blue="0" />
            <start><pos2f x="0" y="0" /></start>
            <end><pos2f x="4" y="0" /></end>
          </rlarrow>
        </redlines>
      </view>
    </viewfolder>
  </viewpoints>
</exchange>
