  <Target Name="CopyBundleArtifacts" AfterTargets="Build" Condition="'$(BundleVersion)' != ''">
    <PropertyGroup>
      <BundleTargetDir>$(MSBuildProjectDirectory)\..\NavisHelper.bundle\Contents\$(BundleVersion)</BundleTargetDir>
    </PropertyGroup>
    <ItemGroup>
      <BundleDependencyFiles Include="@(ReferenceCopyLocalPaths)" />
      <BundleDependencyFiles Include="$(TargetDir)$(TargetFileName).config" Condition="Exists('$(TargetDir)$(TargetFileName).config')" />
      <BundleRussianSatellite Include="$(TargetDir)ru\NavisHelper.resources.dll"
                              Condition="Exists('$(TargetDir)ru\NavisHelper.resources.dll')" />
    </ItemGroup>
    <MakeDir Directories="$(BundleTargetDir)" />
    <Error Condition="'@(BundleRussianSatellite)' == ''"
           Text="Russian satellite assembly was not produced for $(Configuration)." />
    <Copy SourceFiles="$(TargetPath)"
          DestinationFiles="$(BundleTargetDir)\NavisHelper.dll"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(BundleDependencyFiles)"
          DestinationFolder="$(BundleTargetDir)"
          SkipUnchangedFiles="true"
          Condition="'@(BundleDependencyFiles)' != ''" />
    <MakeDir Directories="$(BundleTargetDir)\ru"
             Condition="'@(BundleRussianSatellite)' != ''" />
    <Copy SourceFiles="@(BundleRussianSatellite)"
          DestinationFolder="$(BundleTargetDir)\ru"
          SkipUnchangedFiles="true"
          Condition="'@(BundleRussianSatellite)' != ''" />
    <MakeDir Directories="$(BundleTargetDir)\icons" Condition="'$(BundleVersion)' == '2024' Or '$(BundleVersion)' == '2025' Or '$(BundleVersion)' == '2027'" />
    <Copy SourceFiles="@(BundleIconFiles)"
          DestinationFolder="$(BundleTargetDir)\icons\%(RecursiveDir)"
          SkipUnchangedFiles="true"
          Condition="('$(BundleVersion)' == '2024' Or '$(BundleVersion)' == '2025' Or '$(BundleVersion)' == '2027') And '@(BundleIconFiles)' != ''" />
  </Target>
