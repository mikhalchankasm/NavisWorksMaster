<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>2.20.0.0</Version>
    <AssemblyVersion>2.20.0.0</AssemblyVersion>
    <FileVersion>2.20.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.20" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NavisHelper.Contracts\NavisHelper.Contracts.csproj" />
  </ItemGroup>

  <!-- #440: the net48 Automation runner ships in the server's own output, at the path
       DatasmithExportPlan.ResolveRunnerPath resolves. The server's global properties
       (-r, self-contained, -o) must not reach a net48 build, so they are removed. -->
  <PropertyGroup>
    <_AutomationRunnerProject>..\NavisHelper.AutomationRunner\NavisHelper.AutomationRunner.csproj</_AutomationRunnerProject>
    <_AutomationRunnerRemovedProperties>RuntimeIdentifier;SelfContained;PublishDir;OutputPath;OutDir;TargetFramework;Platform;NoBuild;_IsPublishing</_AutomationRunnerRemovedProperties>
  </PropertyGroup>

  <Target Name="BuildAutomationRunner" AfterTargets="Build">
    <!-- Restore in its own project instance: a build evaluated before restore misses its outputs. -->
    <MSBuild Projects="$(_AutomationRunnerProject)" Targets="Restore"
             Properties="Configuration=$(Configuration);NavisHelperRunnerRestore=true"
             RemoveProperties="$(_AutomationRunnerRemovedProperties)" />
    <MSBuild Projects="$(_AutomationRunnerProject)" Targets="Build"
             Properties="Configuration=$(Configuration)"
             RemoveProperties="$(_AutomationRunnerRemovedProperties)" />
  </Target>

  <!-- Lists the runner's existing output without building it, so `publish no-build` works. -->
  <Target Name="CollectAutomationRunnerFiles">
    <MSBuild Projects="$(_AutomationRunnerProject)" Targets="GetTargetPath"
             Properties="Configuration=$(Configuration)"
             RemoveProperties="$(_AutomationRunnerRemovedProperties)">
      <Output TaskParameter="TargetOutputs" ItemName="_AutomationRunnerOutput" />
    </MSBuild>
    <ItemGroup>
      <_AutomationRunnerFiles Include="@(_AutomationRunnerOutput)" />
      <_AutomationRunnerFiles Include="@(_AutomationRunnerOutput->'%(Identity).config')"
                              Condition="Exists('%(_AutomationRunnerOutput.Identity).config')" />
    </ItemGroup>
  </Target>

  <Target Name="CopyAutomationRunnerToOutput" AfterTargets="BuildAutomationRunner" DependsOnTargets="CollectAutomationRunnerFiles">
    <Copy SourceFiles="@(_AutomationRunnerFiles)"
          DestinationFolder="$(OutDir)AutomationRunner\"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="PublishAutomationRunner" AfterTargets="Publish" DependsOnTargets="CollectAutomationRunnerFiles">
    <Copy SourceFiles="@(_AutomationRunnerFiles)"
          DestinationFolder="$(PublishDir)AutomationRunner\"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
